<UserControl x:Class="MyPlugin.Windows.CounterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:toolbox="clr-namespace:vatSysToolbox;assembly=vatSysToolbox"
             xmlns:viewModels="clr-namespace:MyPlugin.ViewModels"
             Background="{toolbox:VatSysColour WindowBackground}"
             d:DataContext="{d:DesignInstance Type=viewModels:CounterViewModel}"
             mc:Ignorable="d"
             Width="240"
             Height="80">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/vatSysToolbox;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Width" Value="104" />
                <Setter Property="Height" Value="24" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding Count, StringFormat=COUNT {0}}"
                   Foreground="{toolbox:VatSysColour InteractiveText}"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0" />
        <Button Content="INCREMENT" Command="{Binding IncrementCommand}" />
    </StackPanel>
</UserControl>
